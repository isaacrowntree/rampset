/**
 * LiftLog on Cloudflare Workers via @opennextjs/cloudflare.
 * https://opennext.js.org/cloudflare
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "liftlog",
  "main": "custom-worker.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // One origin only. A workers.dev or preview URL would serve the same
  // accounts under a second hostname — its own passkey scope and cookies.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "liftlog.zackdesign.biz",
      "custom_domain": true
    }
  ],
  "services": [
    {
      // Self-reference service binding required by the OpenNext cache layer.
      // The service name must match this worker's name.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "liftlog"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "durable_objects": {
    "bindings": [
      {
        // One journal per account — the ordering point for device sync.
        "name": "SYNC_JOURNAL",
        "class_name": "SyncJournal"
      },
      {
        // Accounts, passkeys, sessions, recovery codes. One instance.
        "name": "AUTH",
        "class_name": "Auth"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SyncJournal"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["Auth"]
    }
  ],
  "r2_buckets": [
    {
      // Per-account backup snapshots, keyed by account id.
      "binding": "BACKUPS",
      "bucket_name": "liftlog-backups"
    }
  ],
  // Recovery codes. Optional: without it (or EMAIL_FROM) the app hides email
  // recovery. EMAIL_FROM's domain must be onboarded to Email Sending:
  //   npx wrangler email sending enable <domain>
  "send_email": [{ "name": "EMAIL" }],
  "vars": {
    "EMAIL_FROM": "noreply@zackdesign.biz"
  },
  // Optional. Per client IP on sign-in and email routes; per account on
  // sync and backup. Period is 10 or 60 seconds.
  "ratelimits": [
    { "name": "AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "API_LIMITER", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } }
  ],
  "observability": {
    "enabled": true
  }
}
