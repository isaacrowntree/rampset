{
  "name": "liftlog",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/isaacrowntree/rampset"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "preview": "opennextjs-cloudflare build && wrangler dev --port 8787 --local-upstream localhost:8787",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "lint": "eslint .",
    "typecheck": "node node_modules/typescript-7/bin/tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:e2e": "opennextjs-cloudflare build && playwright test"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.12",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "durable-auth": "^0.1.0",
    "durable-sync": "^0.3.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "overrides": {
    "postcss": "^8.5.30",
    "@node-minify/core": {
      "glob": "^10.5.0"
    }
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.6",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.2",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-7": "npm:typescript@^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  }
}
